# Copy to .env; Base64 JWT_SECRET must match Auth (at least 32 random decoded bytes).
APP_PORT=8080
CUSTOMER_SERVICE_WS_URI=ws://localhost:8084
# PUBLIC example only; replace before use.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CORS_ALLOW_ORIGIN=http://localhost:5173
AUTH_SERVICE_NAME=auth-service
AUTH_SERVICE_URI=http://localhost:8081
AUTH_SERVICE_PREDICATE=/api/auth/**
AUTH_SERVICE_OPEN_API_PATH=/api-docs
SUBSCRIPTION_SERVICE_NAME=subscription-service
SUBSCRIPTION_SERVICE_URI=http://localhost:8082
SUBSCRIPTION_SERVICE_PREDICATE=/api/subscription/**
SUBSCRIPTION_SERVICE_OPEN_API_PATH=/api-docs
DELIVERY_SERVICE_NAME=delivery-service
DELIVERY_SERVICE_URI=http://localhost:8083
DELIVERY_SERVICE_PREDICATE=/api/delivery/**
DELIVERY_SERVICE_OPEN_API_PATH=/api-docs
CUSTOMER_SERVICE_NAME=customer-service
CUSTOMER_SERVICE_URI=http://localhost:8084
CUSTOMER_SERVICE_PREDICATE=/api/customer/**
CUSTOMER_SERVICE_OPEN_API_PATH=/api-docs
# Same shared Docker network; other services use their actual host ports.
COMPOSE_AUTH_SERVICE_URI=http://auth-service:8081
COMPOSE_CUSTOMER_SERVICE_URI=http://customer-service:8084
COMPOSE_SUBSCRIPTION_SERVICE_URI=http://host.docker.internal:8082
COMPOSE_DELIVERY_SERVICE_URI=http://host.docker.internal:8083
